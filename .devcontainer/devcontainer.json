{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Ckarefulon Android 壳 (Capacitor 8)",

  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    // 容器内必须有 sshd：`gh codespace ssh`（DSH 的 Codespace 工作区插件走的就是这条
    // 数据通道）是在容器**内部**拉起一个 SSH 服务再经 dev tunnel 转发过来的，不是从
    // 外面直连。GitHub 文档的口径：默认 dev container 镜像自带并自动启动 sshd，凡是
    // 用自定义 Dockerfile 的仓库都没有 —— 本仓库正是 `build.dockerfile`，所以必须自己
    // 声明这条 feature，否则 Codespace 能开能停、文件读写和命令一条都跑不了。
    // 改完必须**删除并重建** Codespace 才生效（feature 在创建时烘进容器）。
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  "containerEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk"
  },

  // prebuild 阶段只执行到 updateContentCommand 为止（GitHub 文档明确：生成 prebuild
  // 快照时不会运行 postCreateCommand），所以这里只做「跟依赖有关、又不碰密钥」的事。
  "updateContentCommand": "bash .devcontainer/update-content.sh",

  // 只在真正创建 Codespace 时运行 —— 因此这里恢复的签名私钥不会进入任何快照。
  // 本仓库是公开仓库，任何人都能开 Codespace，密钥进快照等于公开。
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Android Gradle 构建吃内存：2 核容易 OOM 或超时。
  // 想省 Codespaces 额度可以降到 "cpus": 2（构建会明显变慢）。
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      }
    }
  }
}
